index 1c11440..f6d39a1 100644
--- a/apps/web/src/components/records/PatientSearchView.tsx
+++ b/apps/web/src/components/records/PatientSearchView.tsx
@@ -114,7 +114,7 @@ export function PatientSearchView({ basePath, allowOpen = true, allowRegister =
                     ) : state.canOpen ? (
                       <p className="max-w-xs text-xs text-muted">Clinical records are opened by care staff, not from this page.</p>
                     ) : (
-                      <p className="max-w-xs text-xs text-muted">This patient is outside your hospital. Ask hospital management to request access.</p>
+                      <p className="max-w-xs text-xs text-muted">This patient is not registered at or admitted to your hospital yet, so their record is private. Hospital management can ask the patient for approval; once the patient is admitted here, you can open the record.</p>
                     )}
                   </li>
                 );
