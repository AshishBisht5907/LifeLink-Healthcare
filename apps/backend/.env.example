# Local college-project defaults. SQLite keeps setup simple.
USE_SQLITE=True
DEBUG=True
DJANGO_SECRET_KEY=replace-this-for-local-development
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional PostgreSQL configuration: set USE_SQLITE=False to use these.
DB_NAME=lifelink
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Local college-project defaults. This mock does not send SMS.
OTP_PROVIDER=mock
OTP_DEV_MODE=True
OTP_TTL_SECONDS=300
IDENTITY_PROVIDER=mock_aadhaar

# Optional real SMS via Twilio: set OTP_PROVIDER=twilio and OTP_DEV_MODE=False.
# Obtain these values from your Twilio console; never commit real credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
