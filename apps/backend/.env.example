# Local college-project defaults. SQLite keeps setup simple.
USE_SQLITE=True
DEBUG=True
DJANGO_SECRET_KEY=replace-this-for-local-development
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional PostgreSQL configuration: set USE_SQLITE=False to use these.
DB_NAME=lifelink
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Development-only providers. OTP is echoed in the response while enabled.
OTP_PROVIDER=mock
OTP_DEV_MODE=True
IDENTITY_PROVIDER=mock_aadhaar
